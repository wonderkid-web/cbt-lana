# =========================================================
#  Pengaturan port (ubah di sini, tidak perlu edit compose)
#  Setelah diubah jalankan lagi: docker compose up -d
# =========================================================

# Alamat aplikasi CBT  -> http://localhost:<WEB_PORT>
WEB_PORT=8080

# phpMyAdmin           -> http://localhost:<PMA_PORT>
PMA_PORT=8081

# MySQL dari luar (HeidiSQL/DBeaver) -> localhost:<DB_PORT>
DB_PORT=3307
